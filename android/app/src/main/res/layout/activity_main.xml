<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">
    <LinearLayout
        android:id="@+id/rootContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/outline_button" android:padding="10dp"
            android:text="AI/ML · Kotlin · FastAPI · MFCC" android:textColor="@color/cyan" android:textStyle="bold"/>

        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="Deepfake Audio\nDetection System"
            android:textColor="@color/text" android:textSize="38sp" android:textStyle="bold"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="Record or upload audio clips and detect REAL/FAKE voice patterns with confidence score."
            android:textColor="@color/muted" android:textSize="16sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:background="@drawable/card_glass" android:orientation="vertical">

            <com.saksham.deepfakeaudio.ui.WaveformView
                android:id="@+id/waveformView" android:layout_width="match_parent" android:layout_height="130dp"/>

            <TextView android:id="@+id/recordingStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="Tap record to capture audio"
                android:textColor="@color/muted" android:textSize="14sp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <Button android:id="@+id/btnRecord" android:layout_width="0dp" android:layout_height="56dp"
                    android:layout_marginEnd="8dp" android:layout_weight="1" android:background="@drawable/button_gradient"
                    android:text="Start Recording" android:textAllCaps="false" android:textColor="#020617" android:textStyle="bold"/>
                <Button android:id="@+id/btnUpload" android:layout_width="0dp" android:layout_height="56dp"
                    android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/outline_button"
                    android:text="Upload Audio" android:textAllCaps="false" android:textColor="@color/cyan" android:textStyle="bold"/>
            </LinearLayout>

            <Button android:id="@+id/btnAnalyze" android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="14dp" android:background="@drawable/button_gradient"
                android:text="Analyze Audio" android:textAllCaps="false" android:textColor="#020617" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/resultCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:background="@drawable/card_glass" android:orientation="vertical"
            android:visibility="gone">
            <TextView android:id="@+id/txtVerdict" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="REAL" android:textColor="@color/cyan" android:textSize="34sp" android:textStyle="bold"/>
            <ProgressBar android:id="@+id/confidenceProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginTop="12dp"
                android:max="100" android:progress="0"/>
            <TextView android:id="@+id/txtConfidence" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="Confidence: 0%" android:textColor="@color/text"
                android:textSize="17sp" android:textStyle="bold"/>
            <TextView android:id="@+id/txtExplanation" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:textColor="@color/muted" android:textSize="14sp"/>
        </LinearLayout>

        <ProgressBar android:id="@+id/loading" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="center" android:layout_marginTop="20dp" android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
